{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harshasoftware",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,

  // Cloudflare Images binding: on-the-fly resize + AVIF/WebP negotiation for
  // the `/img/*` route (see worker/index.ts). Account-level, works on workers.dev.
  "images": { "binding": "IMAGES" },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only the image-transform route invokes the Worker; every other request is
    // served straight from the asset store (free, no invocation).
    "run_worker_first": ["/img/*"]
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 }

  // After the DNS cutover from Framer, bind the custom domain:
  // "routes": [{ "pattern": "harsha.software", "custom_domain": true }]
}
