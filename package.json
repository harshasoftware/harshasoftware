    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/lekton": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.2.0",
