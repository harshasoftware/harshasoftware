{
  "name": "harshasoftware",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "images": "node scripts/optimize-images.mjs",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
